# Kalshi API Credentials
# Get these from: https://dashboard.kalshi.com/settings/api-keys
# Download your private key and save it as kalshi-key.pem in the project root
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_API_KEY_FILE=kalshi-key.pem

# Optional: Override default Kalshi API base URL
# Default: https://api.elections.kalshi.com/trade-api/v2
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Scanner + Paper Mode
ENABLE_NBA_SCANNER=true
ENABLE_PAPER_TRADING=true

# Paper Strategy Thresholds
PAPER_MIN_EDGE_CENTS=1.5

# Paper Risk Limits / Gates
PAPER_MAX_CONCURRENT_INTENTS=3
PAPER_MAX_OPEN_ORDERS=10
PAPER_MAX_POS_PER_TICKER=1
PAPER_MAX_OPEN_POSITIONS=8
PAPER_MAX_INTENTS_PER_MINUTE=8
PAPER_TICKER_COOLDOWN_SECONDS=90
PAPER_MAX_DAILY_LOSS_CENTS=500

# Paper Exit / Lifecycle
PAPER_TAKE_PROFIT_CENTS=2.0
PAPER_MAX_HOLD_SECONDS=900
PAPER_FILL_HORIZON_SECONDS=120

# Paper Fill Simulator
PAPER_POLL_INTERVAL_SECONDS=3.0
PAPER_SIMULATED_VOLUME_PER_POLL=50
PAPER_FILL_PROBABILITY=0.6
PAPER_FILL_PROBABILITY_AT_BEST=0.20
PAPER_FILL_PROBABILITY_PRICE_IMPROVES=0.05