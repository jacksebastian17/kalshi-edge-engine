# Kalshi API Credentials
# Get these from: https://dashboard.kalshi.com/settings/api-keys
# Download your private key and save it as kalshi-key.pem in the project root
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_API_KEY_FILE=kalshi-key.pem

# Optional: Override default Kalshi API base URL
# Default: https://api.elections.kalshi.com/trade-api/v2
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Scanner + Paper Mode
ENABLE_NBA_SCANNER=true
ENABLE_PAPER_TRADING=true

# Enabled universes
ENABLE_UNIVERSE_NBA=true
ENABLE_UNIVERSE_CBB=false

# ---------------------------------------------------------------------
# Global paper defaults (fallback baseline)
# ---------------------------------------------------------------------

# Entry gating defaults
PAPER_ALLOW_YES_ENTRIES=true
PAPER_ALLOW_NO_ENTRIES=false
PAPER_MIN_TOP_LIQUIDITY=300
PAPER_REQUIRE_SIGNAL_VALID_ONLY=true
PAPER_MIN_CAPTURABLE_EDGE_TO_CROSS_CENTS=5.0
PAPER_MIN_ABS_DISTANCE_FROM_50_CENTS=12.0
PAPER_MIN_REENTRY_DELAY_SECONDS_SAME_TICKER_SIDE=600

# Risk limits / capacity defaults
PAPER_MIN_EDGE_CENTS=3.0
PAPER_MAX_CONCURRENT_INTENTS=3
PAPER_MAX_OPEN_ORDERS=10
PAPER_MAX_POS_PER_TICKER=1
PAPER_MAX_OPEN_POSITIONS=8
PAPER_MAX_INTENTS_PER_MINUTE=6
PAPER_TICKER_COOLDOWN_SECONDS=180
PAPER_MAX_DAILY_LOSS_CENTS=500

# Exit / lifecycle defaults
PAPER_TAKE_PROFIT_CENTS=1.0
PAPER_MAX_HOLD_SECONDS=600
PAPER_FILL_HORIZON_SECONDS=120

# Fill simulator defaults
PAPER_POLL_INTERVAL_SECONDS=3.0
PAPER_SIMULATED_VOLUME_PER_POLL=50
PAPER_FILL_PROBABILITY=0.35
PAPER_FILL_PROBABILITY_AT_BEST=0.10
PAPER_FILL_PROBABILITY_PRICE_IMPROVES=0.03

# ---------------------------------------------------------------------
# NBA overrides (active)
# ---------------------------------------------------------------------
PAPER_NBA_MIN_EDGE_CENTS=2.0
PAPER_NBA_MIN_TOP_LIQUIDITY=200
PAPER_NBA_MIN_CAPTURABLE_EDGE_TO_CROSS_CENTS=3.0
PAPER_NBA_MIN_ABS_DISTANCE_FROM_50_CENTS=8.0
PAPER_NBA_MIN_REENTRY_DELAY_SECONDS_SAME_TICKER_SIDE=180
PAPER_NBA_FILL_PROBABILITY=0.35
PAPER_NBA_FILL_PROBABILITY_AT_BEST=0.10
PAPER_NBA_FILL_PROBABILITY_PRICE_IMPROVES=0.03
PAPER_NBA_SIMULATED_VOLUME_PER_POLL=50
PAPER_NBA_POLL_INTERVAL_SECONDS=3.0
PAPER_NBA_FILL_HORIZON_SECONDS=120
PAPER_NBA_TAKE_PROFIT_CENTS_PER_CONTRACT=1.0
PAPER_NBA_MAX_HOLD_SECONDS=600
PAPER_NBA_TICKER_COOLDOWN_SECONDS=180

PAPER_NBA_ALLOW_PRICE_IMPROVES=true
PAPER_NBA_MIN_EDGE_CENTS_PRICE_IMPROVES=3.5
PAPER_NBA_ALLOW_MOVED_THROUGH=true
PAPER_NBA_MIN_EDGE_CENTS_MOVED_THROUGH=2.0

# Keep concentration caps off for now
# PAPER_NBA_MAX_ENTRY_SAMPLES_PER_TICKER_PER_HOUR=2
# PAPER_NBA_MAX_ENTRY_SAMPLES_PER_TICKER_SIDE_PER_HOUR=1
# PAPER_NBA_MIN_DISTINCT_TICKERS_FOR_STRATEGY_CONFIDENCE=3

# CBB overrides (examples)
# PAPER_CBB_MIN_EDGE_CENTS=2.5
# PAPER_CBB_MIN_TOP_LIQUIDITY=300
# PAPER_CBB_MIN_CAPTURABLE_EDGE_TO_CROSS_CENTS=5.0
# PAPER_CBB_MIN_ABS_DISTANCE_FROM_50_CENTS=12.0
# PAPER_CBB_MIN_REENTRY_DELAY_SECONDS_SAME_TICKER_SIDE=600
# PAPER_CBB_FILL_PROBABILITY=0.35
# PAPER_CBB_FILL_PROBABILITY_AT_BEST=0.10
# PAPER_CBB_FILL_PROBABILITY_PRICE_IMPROVES=0.03
# PAPER_CBB_ALLOW_PRICE_IMPROVES=true
# PAPER_CBB_MIN_EDGE_CENTS_PRICE_IMPROVES=
# PAPER_CBB_ALLOW_MOVED_THROUGH=true
# PAPER_CBB_MIN_EDGE_CENTS_MOVED_THROUGH=
# PAPER_CBB_MAX_ENTRY_SAMPLES_PER_TICKER_PER_HOUR=
# PAPER_CBB_MAX_ENTRY_SAMPLES_PER_TICKER_SIDE_PER_HOUR=
# PAPER_CBB_MIN_DISTINCT_TICKERS_FOR_STRATEGY_CONFIDENCE=
# PAPER_CBB_SIMULATED_VOLUME_PER_POLL=50
# PAPER_CBB_POLL_INTERVAL_SECONDS=3.0
# PAPER_CBB_FILL_HORIZON_SECONDS=120
# PAPER_CBB_TAKE_PROFIT_CENTS_PER_CONTRACT=1.0
# PAPER_CBB_MAX_HOLD_SECONDS=600
# PAPER_CBB_TICKER_COOLDOWN_SECONDS=180