# Kalshi API Credentials
# Get these from: https://dashboard.kalshi.com/settings/api-keys
# Download your private key and save it as kalshi-key.pem in the project root
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_API_KEY_FILE=kalshi-key.pem

# Optional: Override default Kalshi API base URL
# Default: https://api.elections.kalshi.com/trade-api/v2
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Trading Configuration (for future use)
TRADING_MODE=signals  # signals, paper, or live
AUTO_TRADING=false     # Always start with false
MAX_ORDER_SIZE=0       # Not used yet
MAX_POSITION_SIZE=0    # Not used yet
MAX_DAILY_LOSS=0       # Not used yet
MIN_SPREAD_AFTER_FEES=0.01
MIN_TOP_LIQUIDITY=0
MIN_MINUTES_TO_EXPIRY=1

ENABLE_DEV_CORS=true
ENABLE_NBA_SCANNER=true
ENABLE_PAPER_TRADING=true

PAPER_MIN_EDGE_CENTS=1.0
PAPER_MAX_CONCURRENT_INTENTS=5
PAPER_MAX_OPEN_ORDERS=20
PAPER_MAX_INTENTS_PER_MINUTE=30
PAPER_TICKER_COOLDOWN_SECONDS=60
PAPER_MAX_POS_PER_TICKER=1
PAPER_TAKE_PROFIT_CENTS=2
PAPER_MAX_HOLD_SECONDS=600
PAPER_FILL_HORIZON_SECONDS=90
PAPER_POLL_INTERVAL_SECONDS=2.0
PAPER_SIMULATED_VOLUME_PER_POLL=100
PAPER_FILL_PROBABILITY=0.8
PAPER_FILL_PROBABILITY_AT_BEST=0.35